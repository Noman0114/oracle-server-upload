<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in - YouTube</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <script>
    (function() {
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      --yt-bg: #f9f9f9;
      --yt-card-bg: #ffffff;
      --yt-border: #dadce0;
      --yt-text-primary: #202124;
      --yt-text-secondary: #5f6368;
      --yt-brand-red: #ff0000;
      --yt-brand-red-dark: #cc0000;
      --yt-blue: #065fd4;
      --yt-blue-hover: #044fb5;
      --yt-input-bg: #ffffff;
      --yt-input-border: #747775;
      --yt-input-focus: #065fd4;
      --yt-error-bg: #fce8e6;
      --yt-error-text: #c5221f;
      --yt-footer-text: #70757a;
    }

    html.dark {
      --yt-bg: #0f0f0f;
      --yt-card-bg: #1f1f1f;
      --yt-border: #383838;
      --yt-text-primary: #f1f1f1;
      --yt-text-secondary: #aaaaaa;
      --yt-brand-red: #ff0000;
      --yt-brand-red-dark: #cc0000;
      --yt-blue: #3ea6ff;
      --yt-blue-hover: #65b8ff;
      --yt-input-bg: #121212;
      --yt-input-border: #525252;
      --yt-input-focus: #3ea6ff;
      --yt-error-bg: rgba(234, 67, 53, 0.15);
      --yt-error-text: #f28b82;
      --yt-footer-text: #8e8e8e;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      transition: background-color 0.2s, border-color 0.2s, color 0.2s;
    }

    body {
      font-family: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--yt-bg);
      color: var(--yt-text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      padding: 24px;
    }

    .theme-toggle-top {
      position: absolute;
      top: 20px;
      right: 24px;
    }

    .btn-theme {
      background: none;
      border: 1px solid var(--yt-border);
      border-radius: 20px;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 500;
      color: var(--yt-text-primary);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-theme:hover {
      background-color: rgba(128, 128, 128, 0.1);
    }

    .login-container {
      width: 100%;
      max-width: 448px;
      background: var(--yt-card-bg);
      border: 1px solid var(--yt-border);
      border-radius: 28px;
      padding: 40px;
      margin-top: auto;
      margin-bottom: auto;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .brand-header {
      text-align: left;
      margin-bottom: 32px;
    }

    .yt-logo-wrap {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      text-decoration: none;
      margin-bottom: 20px;
    }

    .yt-icon {
      width: 32px;
      height: 24px;
    }

    .yt-wordmark {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.8px;
      color: var(--yt-text-primary);
      display: flex;
      align-items: center;
    }

    .yt-badge {
      font-size: 10px;
      font-weight: 500;
      color: var(--yt-text-secondary);
      margin-left: 4px;
      position: relative;
      top: -6px;
    }

    .login-title {
      font-size: 24px;
      font-weight: 500;
      color: var(--yt-text-primary);
      margin-bottom: 8px;
    }

    .login-subtitle {
      font-size: 15px;
      color: var(--yt-text-secondary);
      line-height: 1.4;
    }

    .error-alert {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--yt-error-bg);
      color: var(--yt-error-text);
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 24px;
    }

    .form-group {
      margin-bottom: 22px;
      position: relative;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--yt-text-secondary);
      margin-bottom: 8px;
    }

    .input-field {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid var(--yt-input-border);
      border-radius: 10px;
      background: var(--yt-input-bg);
      color: var(--yt-text-primary);
      font-size: 15px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-field:focus {
      border-color: var(--yt-brand-red);
      box-shadow: 0 0 0 2px rgba(255, 0, 0, 0.2);
    }

    .password-wrapper {
      position: relative;
    }

    .toggle-pass-btn {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--yt-text-secondary);
      cursor: pointer;
      font-size: 16px;
      padding: 4px;
    }

    .hint-box {
      background: rgba(128, 128, 128, 0.08);
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 12px;
      color: var(--yt-text-secondary);
      margin-bottom: 28px;
      line-height: 1.5;
    }

    .hint-box strong {
      color: var(--yt-text-primary);
    }

    .form-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 32px;
    }

    .btn-create {
      background: none;
      border: none;
      color: var(--yt-brand-red);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 18px;
      text-decoration: none;
    }

    .btn-create:hover {
      background-color: rgba(255, 0, 0, 0.08);
    }

    .btn-submit {
      background-color: var(--yt-brand-red);
      color: #ffffff;
      border: none;
      padding: 11px 26px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background-color 0.2s, transform 0.1s;
    }

    .btn-submit:hover {
      background-color: var(--yt-brand-red-dark);
    }

    .btn-submit:active {
      transform: scale(0.98);
    }

    .login-footer {
      width: 100%;
      max-width: 448px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: var(--yt-footer-text);
      padding-top: 16px;
    }

    .footer-links {
      display: flex;
      gap: 16px;
    }

    .footer-links a {
      color: var(--yt-footer-text);
      text-decoration: none;
    }

    .footer-links a:hover {
      color: var(--yt-text-primary);
    }

    @media (max-width: 480px) {
      .login-container {
        border: none;
        padding: 24px 16px;
        background: transparent;
        box-shadow: none;
      }
      .login-footer {
        flex-direction: column;
        gap: 12px;
        text-align: center;
      }
    }
  </style>
</head>
<body>

  <div class="theme-toggle-top">
    <button type="button" class="btn-theme" onclick="toggleTheme()" id="themeBtn" aria-label="Toggle theme">
      <span id="themeIcon">🌙</span> <span id="themeText">Appearance</span>
    </button>
  </div>

  <div class="login-container">
    <div class="brand-header">
      <div class="yt-logo-wrap">
        <!-- Exact YouTube Play Button SVG -->
        <svg class="yt-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z" fill="#FF0000"/>
          <polygon points="9.545,15.568 15.818,12 9.545,8.432" fill="#FFFFFF"/>
        </svg>
        <span class="yt-wordmark">YouTube <span class="yt-badge">Cloud</span></span>
      </div>
      <h1 class="login-title">Sign in</h1>
      <p class="login-subtitle">to continue to YouTube Cloud Server</p>
    </div>

    <% if (error) { %>
      <div class="error-alert">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label for="username">Username or email</label>
        <input type="text" id="username" name="username" class="input-field" required autocomplete="username" autofocus placeholder="Enter username">
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <div class="password-wrapper">
          <input type="password" id="password" name="password" class="input-field" required autocomplete="current-password" placeholder="Enter password">
          <button type="button" class="toggle-pass-btn" onclick="togglePasswordVisibility()" title="Show/hide password" aria-label="Toggle password visibility">👁️</button>
        </div>
      </div>

      <div class="hint-box">
        🔑 <strong>Server Login:</strong> Username: <code>numan</code> &bull; Password: <code>numan114</code>
      </div>

      <div class="form-actions">
        <a href="#" onclick="alert('Default login credentials are: numan / numan114'); return false;" class="btn-create">Help?</a>
        <button type="submit" class="btn-submit">
          <span>Sign in</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </form>
  </div>

  <div class="login-footer">
    <span>English (United States)</span>
    <div class="footer-links">
      <a href="https://support.google.com/youtube" target="_blank" rel="noreferrer">Help</a>
      <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy</a>
      <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms</a>
    </div>
  </div>

  <script>
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI(isDark);
    }

    function updateThemeUI(isDark) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      if (icon) icon.textContent = isDark ? '☀️' : '🌙';
      if (text) text.textContent = isDark ? 'Light' : 'Dark';
    }

    function togglePasswordVisibility() {
      const pass = document.getElementById('password');
      if (pass.type === 'password') {
        pass.type = 'text';
      } else {
        pass.type = 'password';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const isDark = document.documentElement.classList.contains('dark');
      updateThemeUI(isDark);
    });
  </script>
</body>
</html>
