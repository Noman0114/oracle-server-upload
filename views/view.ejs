<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= file.name %> - YouTube</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <script>
    (function() {
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      --yt-bg: #f9f9f9;
      --yt-nav-bg: #ffffff;
      --yt-card-bg: #ffffff;
      --yt-secondary-bg: #f2f2f2;
      --yt-hover-bg: #e5e5e5;
      --yt-border: #e5e5e5;
      --yt-text-primary: #0f0f0f;
      --yt-text-secondary: #606060;
      --yt-text-muted: #909090;
      --yt-brand-red: #ff0000;
      --yt-chip-bg: rgba(0, 0, 0, 0.05);
      --yt-chip-active-bg: #0f0f0f;
      --yt-chip-active-text: #ffffff;
      --yt-search-border: #ccc;
      --yt-search-btn-bg: #f8f8f8;
      --yt-pill-btn-bg: #f2f2f2;
      --yt-pill-btn-hover: #e5e5e5;
      --yt-pill-btn-text: #0f0f0f;
      --yt-sub-btn-bg: #0f0f0f;
      --yt-sub-btn-text: #ffffff;
      --yt-danger: #cc0000;
    }

    html.dark {
      --yt-bg: #0f0f0f;
      --yt-nav-bg: #0f0f0f;
      --yt-card-bg: #1f1f1f;
      --yt-secondary-bg: #272727;
      --yt-hover-bg: #383838;
      --yt-border: #272727;
      --yt-text-primary: #f1f1f1;
      --yt-text-secondary: #aaaaaa;
      --yt-text-muted: #717171;
      --yt-brand-red: #ff0000;
      --yt-chip-bg: rgba(255, 255, 255, 0.1);
      --yt-chip-active-bg: #f1f1f1;
      --yt-chip-active-text: #0f0f0f;
      --yt-search-border: #303030;
      --yt-search-btn-bg: #222222;
      --yt-pill-btn-bg: #272727;
      --yt-pill-btn-hover: #3f3f3f;
      --yt-pill-btn-text: #f1f1f1;
      --yt-sub-btn-bg: #f1f1f1;
      --yt-sub-btn-text: #0f0f0f;
      --yt-danger: #ff4e45;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    }

    body {
      font-family: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--yt-bg);
      color: var(--yt-text-primary);
      min-height: 100vh;
      line-height: 1.4;
    }

    /* TOP NAVBAR (MASTHEAD) */
    .yt-masthead {
      position: sticky;
      top: 0;
      z-index: 200;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 16px;
      height: 56px;
      background: var(--yt-nav-bg);
      border-bottom: 1px solid var(--yt-border);
    }

    .masthead-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .icon-btn {
      background: none;
      border: none;
      color: var(--yt-text-primary);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .icon-btn:hover {
      background-color: var(--yt-hover-bg);
    }

    .yt-logo {
      display: flex;
      align-items: center;
      gap: 4px;
      text-decoration: none;
      cursor: pointer;
    }

    .yt-logo-icon {
      width: 30px;
      height: 22px;
    }

    .yt-logo-text {
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -0.8px;
      color: var(--yt-text-primary);
      display: flex;
      align-items: center;
    }

    .yt-country-code {
      font-size: 10px;
      color: var(--yt-text-secondary);
      margin-left: 3px;
      font-weight: 400;
      position: relative;
      top: -5px;
    }

    /* SEARCH BAR */
    .masthead-center {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 0 1 732px;
      justify-content: center;
      margin: 0 16px;
    }

    .search-box-form {
      display: flex;
      align-items: center;
      width: 100%;
      max-width: 600px;
    }

    .search-input-wrap {
      display: flex;
      align-items: center;
      flex: 1;
      height: 40px;
      padding: 0 16px;
      border: 1px solid var(--yt-search-border);
      border-right: none;
      border-radius: 40px 0 0 40px;
      background: var(--yt-nav-bg);
    }

    .search-input-wrap:focus-within {
      border-color: #1c62b9;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.2);
    }

    .search-input {
      width: 100%;
      border: none;
      background: transparent;
      outline: none;
      font-size: 16px;
      color: var(--yt-text-primary);
    }

    .search-btn {
      width: 64px;
      height: 40px;
      border: 1px solid var(--yt-search-border);
      border-radius: 0 40px 40px 0;
      background: var(--yt-search-btn-bg);
      color: var(--yt-text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .search-btn:hover {
      background-color: var(--yt-hover-bg);
    }

    .mic-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--yt-secondary-bg);
      border: none;
      color: var(--yt-text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .mic-btn:hover {
      background: var(--yt-hover-bg);
    }

    /* RIGHT ACTIONS */
    .masthead-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-create-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      height: 36px;
      padding: 0 16px;
      border-radius: 18px;
      background: var(--yt-pill-btn-bg);
      color: var(--yt-pill-btn-text);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      border: none;
    }

    .btn-create-pill:hover {
      background: var(--yt-pill-btn-hover);
    }

    .user-avatar-pill {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ff0000, #b30000);
      color: white;
      font-weight: 700;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
    }

    /* MAIN WATCH LAYOUT */
    .watch-layout {
      max-width: 1750px;
      margin: 0 auto;
      padding: 24px 24px 48px;
      display: grid;
      grid-template-columns: 1fr 402px;
      gap: 24px;
    }

    @media (max-width: 1200px) {
      .watch-layout {
        grid-template-columns: 1fr;
        padding: 16px 16px 40px;
      }
    }

    /* THEATER PLAYER CONTAINER */
    .watch-primary {
      min-width: 0;
    }

    .player-container {
      width: 100%;
      aspect-ratio: 16 / 9;
      max-height: 75vh;
      background: #000000;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      position: relative;
    }

    .player-video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
    }

    .player-image {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      cursor: zoom-in;
    }

    .player-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #fff;
      text-align: center;
      padding: 24px;
    }

    .placeholder-icon {
      font-size: 64px;
      margin-bottom: 16px;
    }

    .placeholder-title {
      font-size: 20px;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .placeholder-desc {
      font-size: 14px;
      color: #aaa;
      margin-bottom: 20px;
    }

    /* VIDEO INFO & TITLE */
    .video-title {
      font-size: 20px;
      font-weight: 700;
      line-height: 28px;
      margin-top: 14px;
      margin-bottom: 12px;
      color: var(--yt-text-primary);
      word-break: break-word;
    }

    .watch-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 16px;
    }

    .channel-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .channel-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #065fd4, #7028e4);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 16px;
    }

    .channel-text {
      display: flex;
      flex-direction: column;
    }

    .channel-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--yt-text-primary);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .verified-badge {
      width: 14px;
      height: 14px;
      fill: var(--yt-text-secondary);
    }

    .channel-subs {
      font-size: 12px;
      color: var(--yt-text-secondary);
    }

    .btn-subscribe {
      background: var(--yt-sub-btn-bg);
      color: var(--yt-sub-btn-text);
      border: none;
      padding: 0 16px;
      height: 36px;
      border-radius: 18px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      margin-left: 12px;
      transition: opacity 0.2s;
    }

    .btn-subscribe:hover {
      opacity: 0.9;
    }

    .btn-subscribe.subscribed {
      background: var(--yt-secondary-bg);
      color: var(--yt-text-primary);
    }

    /* ACTION BUTTONS (LIKE, SHARE, DOWNLOAD, DELETE) */
    .video-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-segmented {
      display: flex;
      align-items: center;
      background: var(--yt-secondary-bg);
      border-radius: 18px;
      height: 36px;
      overflow: hidden;
    }

    .btn-segment {
      display: flex;
      align-items: center;
      gap: 6px;
      height: 100%;
      padding: 0 16px;
      border: none;
      background: transparent;
      color: var(--yt-text-primary);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
    }

    .btn-segment:hover {
      background: var(--yt-hover-bg);
    }

    .btn-segment-divider {
      width: 1px;
      height: 20px;
      background: var(--yt-border);
    }

    .btn-action-pill {
      display: flex;
      align-items: center;
      gap: 6px;
      height: 36px;
      padding: 0 16px;
      border-radius: 18px;
      background: var(--yt-secondary-bg);
      color: var(--yt-text-primary);
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-action-pill:hover {
      background: var(--yt-hover-bg);
    }

    .btn-action-pill.danger {
      color: var(--yt-danger);
    }

    /* DESCRIPTION BOX */
    .description-box {
      background: var(--yt-secondary-bg);
      border-radius: 12px;
      padding: 14px 16px;
      font-size: 14px;
      margin-bottom: 24px;
      cursor: pointer;
    }

    .description-box:hover {
      background: var(--yt-hover-bg);
    }

    .desc-header {
      font-weight: 600;
      color: var(--yt-text-primary);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .desc-tag {
      color: #065fd4;
      font-weight: 500;
    }

    html.dark .desc-tag {
      color: #3ea6ff;
    }

    .desc-body {
      color: var(--yt-text-primary);
      line-height: 1.6;
      word-break: break-all;
    }

    .desc-meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--yt-border);
    }

    .desc-meta-item {
      display: flex;
      flex-direction: column;
    }

    .desc-meta-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--yt-text-secondary);
      margin-bottom: 2px;
    }

    .desc-meta-val {
      font-size: 13px;
      font-weight: 600;
      color: var(--yt-text-primary);
    }

    /* COMMENTS SECTION */
    .comments-section {
      margin-top: 24px;
    }

    .comments-header {
      display: flex;
      align-items: center;
      gap: 32px;
      margin-bottom: 24px;
    }

    .comments-count {
      font-size: 20px;
      font-weight: 700;
    }

    .comments-sort {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .add-comment-row {
      display: flex;
      gap: 16px;
      margin-bottom: 32px;
    }

    .add-comment-input {
      flex: 1;
      border: none;
      border-bottom: 1px solid var(--yt-border);
      background: transparent;
      padding: 8px 0;
      font-size: 14px;
      color: var(--yt-text-primary);
      outline: none;
    }

    .add-comment-input:focus {
      border-bottom: 2px solid var(--yt-text-primary);
    }

    .comment-item {
      display: flex;
      gap: 16px;
      margin-bottom: 20px;
    }

    .comment-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #717171;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      flex-shrink: 0;
    }

    .comment-content {
      flex: 1;
    }

    .comment-user-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .comment-user {
      font-size: 13px;
      font-weight: 600;
      color: var(--yt-text-primary);
    }

    .comment-time {
      font-size: 12px;
      color: var(--yt-text-secondary);
    }

    .comment-text {
      font-size: 14px;
      color: var(--yt-text-primary);
      line-height: 1.4;
      margin-bottom: 6px;
    }

    .comment-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 12px;
      color: var(--yt-text-secondary);
    }

    /* RIGHT SIDEBAR (UP NEXT RECOMMENDATIONS) */
    .watch-secondary {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .sidebar-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: none;
    }

    .sidebar-chips::-webkit-scrollbar {
      display: none;
    }

    .chip-item {
      padding: 6px 12px;
      border-radius: 8px;
      background: var(--yt-secondary-bg);
      color: var(--yt-text-primary);
      font-size: 13px;
      font-weight: 500;
      white-space: nowrap;
      text-decoration: none;
      cursor: pointer;
    }

    .chip-item.active {
      background: var(--yt-text-primary);
      color: var(--yt-bg);
    }

    .rec-card {
      display: flex;
      gap: 8px;
      text-decoration: none;
      color: inherit;
      border-radius: 8px;
      padding: 4px;
      transition: background-color 0.15s;
    }

    .rec-card:hover {
      background: var(--yt-hover-bg);
    }

    .rec-thumb-wrap {
      position: relative;
      width: 168px;
      height: 94px;
      border-radius: 8px;
      overflow: hidden;
      background: #000;
      flex-shrink: 0;
    }

    .rec-thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .rec-thumb-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      background: var(--yt-secondary-bg);
      color: var(--yt-text-secondary);
    }

    .rec-badge {
      position: absolute;
      bottom: 4px;
      right: 4px;
      background: rgba(0, 0, 0, 0.8);
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 4px;
      border-radius: 4px;
    }

    .rec-info {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .rec-title {
      font-size: 14px;
      font-weight: 600;
      line-height: 18px;
      max-height: 36px;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      margin-bottom: 4px;
      color: var(--yt-text-primary);
    }

    .rec-channel {
      font-size: 12px;
      color: var(--yt-text-secondary);
      margin-bottom: 2px;
    }

    .rec-meta {
      font-size: 12px;
      color: var(--yt-text-secondary);
    }

    /* TOAST */
    .toast-msg {
      position: fixed;
      bottom: 24px;
      left: 24px;
      background: #0f0f0f;
      color: #ffffff;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      z-index: 1000;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
      display: none;
      animation: fadeIn 0.2s ease;
    }

    html.dark .toast-msg {
      background: #f1f1f1;
      color: #0f0f0f;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* MODAL */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 500;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-box {
      background: var(--yt-card-bg);
      border: 1px solid var(--yt-border);
      border-radius: 16px;
      padding: 24px;
      max-width: 440px;
      width: 100%;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }

    .modal-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .modal-desc {
      font-size: 14px;
      color: var(--yt-text-secondary);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .btn-modal-cancel {
      padding: 8px 16px;
      border-radius: 18px;
      border: none;
      background: var(--yt-secondary-bg);
      color: var(--yt-text-primary);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-modal-delete {
      padding: 8px 16px;
      border-radius: 18px;
      border: none;
      background: var(--yt-danger);
      color: white;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .masthead-center {
        display: none;
      }
      .watch-layout {
        padding: 0 0 32px;
      }
      .player-container {
        border-radius: 0;
      }
      .watch-primary {
        padding: 0 16px;
      }
      .watch-secondary {
        padding: 0 16px;
      }
    }
  </style>
</head>
<body>

  <!-- TOP MASTHEAD -->
  <header class="yt-masthead">
    <div class="masthead-left">
      <a href="/dashboard" class="icon-btn" title="Back to Home">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
        </svg>
      </a>
      <a href="/dashboard" class="yt-logo">
        <svg class="yt-logo-icon" viewBox="0 0 24 24" fill="none">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z" fill="#FF0000"/>
          <polygon points="9.545,15.568 15.818,12 9.545,8.432" fill="#FFFFFF"/>
        </svg>
        <span class="yt-logo-text">YouTube <span class="yt-country-code">Cloud</span></span>
      </a>
    </div>

    <div class="masthead-center">
      <form action="/dashboard" method="GET" class="search-box-form">
        <div class="search-input-wrap">
          <input type="text" name="search" class="search-input" placeholder="Search files, videos, photos...">
        </div>
        <button type="submit" class="search-btn" title="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
        </button>
      </form>
      <button type="button" class="mic-btn" title="Search with your voice" onclick="showToast('Voice search ready')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.38-1.14-1-1.14z"/>
        </svg>
      </button>
    </div>

    <div class="masthead-right">
      <a href="/dashboard" class="btn-create-pill">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4zM14 13h-3v3H9v-3H6v-2h3V8h2v3h3v2z"/>
        </svg>
        <span>Upload</span>
      </a>

      <button type="button" class="icon-btn" onclick="toggleTheme()" title="Toggle Dark/Light theme">
        <span id="themeIcon" style="font-size: 18px;">🌙</span>
      </button>

      <a href="/dashboard" class="user-avatar-pill" title="Numan - Oracle Server">N</a>
    </div>
  </header>

  <!-- WATCH MAIN LAYOUT -->
  <main class="watch-layout">

    <!-- LEFT COLUMN: PRIMARY MEDIA & WATCH DETAILS -->
    <div class="watch-primary">
      
      <!-- THEATER PLAYER -->
      <div class="player-container">
        <% if (file.category === 'videos') { %>
          <video class="player-video" controls autoplay playsinline preload="auto">
            <source src="<%= file.path %>">
            Your browser does not support the video tag.
          </video>
        <% } else if (file.category === 'images') { %>
          <img src="<%= file.path %>" alt="<%= file.name %>" class="player-image" id="playerImage" onclick="window.open('<%= file.path %>', '_blank')">
        <% } else { %>
          <div class="player-placeholder">
            <div class="placeholder-icon">
              <% if (file.category === 'archives') { %>📦<% } else if (file.category === 'documents') { %>📄<% } else { %>📁<% } %>
            </div>
            <div class="placeholder-title"><%= file.name %></div>
            <div class="placeholder-desc"><%= file.category.toUpperCase() %> File &bull; <%= (file.size / 1024 / 1024).toFixed(2) %> MB</div>
            <a href="<%= file.downloadPath || file.path %>" class="btn-subscribe" download>
              ⬇ Download to Open
            </a>
          </div>
        <% } %>
      </div>

      <!-- TITLE -->
      <h1 class="video-title"><%= file.name %></h1>

      <!-- CHANNEL & ACTIONS ROW -->
      <div class="watch-meta-row">
        <!-- CHANNEL -->
        <div class="channel-info">
          <div class="channel-avatar">N</div>
          <div class="channel-text">
            <div class="channel-name">
              <span>Oracle Cloud Server</span>
              <svg class="verified-badge" viewBox="0 0 24 24">
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1.9 14.7L6 12.6l1.4-1.4 2.7 2.7 6.5-6.5 1.4 1.4-7.9 7.9z"/>
              </svg>
            </div>
            <span class="channel-subs">1.42M subscribers &bull; Admin</span>
          </div>
          <button type="button" class="btn-subscribe" id="subBtn" onclick="toggleSubscribe()">Subscribe</button>
        </div>

        <!-- YOUTUBE ACTION PILLS -->
        <div class="video-actions">
          <!-- LIKE / DISLIKE -->
          <div class="btn-segmented">
            <button type="button" class="btn-segment" id="likeBtn" onclick="toggleLike()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/>
              </svg>
              <span id="likeCount">14K</span>
            </button>
            <div class="btn-segment-divider"></div>
            <button type="button" class="btn-segment" onclick="showToast('Feedback submitted')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z"/>
              </svg>
            </button>
          </div>

          <!-- SHARE -->
          <button type="button" class="btn-action-pill" onclick="copyShareUrl()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"/>
            </svg>
            <span>Share</span>
          </button>

          <!-- DOWNLOAD -->
          <a href="<%= file.downloadPath || file.path %>" class="btn-action-pill" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
            </svg>
            <span>Download</span>
          </a>

          <!-- DELETE -->
          <button type="button" class="btn-action-pill danger" onclick="openDeleteModal()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
            </svg>
            <span>Delete</span>
          </button>
        </div>
      </div>

      <!-- DESCRIPTION BOX -->
      <div class="description-box" onclick="toggleDescExpand()">
        <div class="desc-header">
          <span><%= (file.size > 1000000 ? Math.floor(file.size / 340) : 4821).toLocaleString() %> views</span>
          <span>&bull;</span>
          <span>Uploaded <%= new Date(file.uploadDate || Date.now()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          <span class="desc-tag">#OracleServer</span>
          <span class="desc-tag">#<%= file.category %></span>
          <span class="desc-tag">#Numan</span>
        </div>
        <div class="desc-body">
          Original filename: <strong><%= file.name %></strong>.<br>
          Hosted and streamed directly from Oracle Cloud Linux Server. Fast global access with full MIME streaming support.
        </div>
        <div class="desc-meta-grid">
          <div class="desc-meta-item">
            <span class="desc-meta-label">Category</span>
            <span class="desc-meta-val"><%= file.category.toUpperCase() %></span>
          </div>
          <div class="desc-meta-item">
            <span class="desc-meta-label">File Size</span>
            <span class="desc-meta-val"><%= (file.size / 1024 / 1024).toFixed(2) %> MB</span>
          </div>
          <div class="desc-meta-item">
            <span class="desc-meta-label">Storage Route</span>
            <span class="desc-meta-val">/uploads/<%= file.category %>/</span>
          </div>
          <div class="desc-meta-item">
            <span class="desc-meta-label">Status</span>
            <span class="desc-meta-val" style="color: #059669;">● Publicly Available</span>
          </div>
        </div>
      </div>

      <!-- COMMENTS SECTION -->
      <section class="comments-section">
        <div class="comments-header">
          <h2 class="comments-count">12 Comments</h2>
          <div class="comments-sort">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/>
            </svg>
            <span>Sort by</span>
          </div>
        </div>

        <div class="add-comment-row">
          <div class="channel-avatar" style="width: 36px; height: 36px; font-size: 14px;">N</div>
          <input type="text" class="add-comment-input" placeholder="Add a comment..." onkeydown="handleCommentSubmit(event, this)">
        </div>

        <div id="commentsList">
          <div class="comment-item">
            <div class="comment-avatar">A</div>
            <div class="comment-content">
              <div class="comment-user-row">
                <span class="comment-user">@ali_khan</span>
                <span class="comment-time">2 hours ago</span>
              </div>
              <div class="comment-text">Super fast streaming speed from the Oracle Server! Quality is crystal clear. 🔥</div>
              <div class="comment-actions">
                <span>👍 42</span> &bull; <span>Reply</span>
              </div>
            </div>
          </div>

          <div class="comment-item">
            <div class="comment-avatar" style="background: #2563eb;">Z</div>
            <div class="comment-content">
              <div class="comment-user-row">
                <span class="comment-user">@zain_developer</span>
                <span class="comment-time">1 day ago</span>
              </div>
              <div class="comment-text">The YouTube interface matches completely! Everything works seamlessly.</div>
              <div class="comment-actions">
                <span>👍 18</span> &bull; <span>Reply</span>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- RIGHT COLUMN: UP NEXT RECOMMENDATIONS -->
    <aside class="watch-secondary">
      <div class="sidebar-chips">
        <span class="chip-item active">All</span>
        <span class="chip-item">From <%= file.category %></span>
        <span class="chip-item">Recently uploaded</span>
      </div>

      <% if (typeof relatedFiles !== 'undefined' && relatedFiles.length > 0) { %>
        <% relatedFiles.forEach(rel => { %>
          <a href="/view/<%= rel.category %>/<%= encodeURIComponent(rel.name) %>" class="rec-card">
            <div class="rec-thumb-wrap">
              <% if (rel.category === 'images') { %>
                <img src="/uploads/<%= rel.category %>/<%= encodeURIComponent(rel.name) %>" alt="<%= rel.name %>" class="rec-thumb" loading="lazy">
              <% } else if (rel.category === 'videos') { %>
                <video src="/uploads/<%= rel.category %>/<%= encodeURIComponent(rel.name) %>" class="rec-thumb" muted preload="metadata"></video>
              <% } else { %>
                <div class="rec-thumb-placeholder">
                  <% if (rel.category === 'archives') { %>📦<% } else if (rel.category === 'documents') { %>📄<% } else { %>📁<% } %>
                </div>
              <% } %>
              <span class="rec-badge"><%= (rel.size / 1024 / 1024).toFixed(1) %> MB</span>
            </div>
            <div class="rec-info">
              <div class="rec-title" title="<%= rel.name %>"><%= rel.name %></div>
              <div class="rec-channel">Oracle Cloud &bull; Numan</div>
              <div class="rec-meta">
                <span><%= rel.category %></span> &bull; 
                <span><%= new Date(rel.uploadDate || Date.now()).toLocaleDateString() %></span>
              </div>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div style="color: var(--yt-text-secondary); font-size: 14px; text-align: center; padding: 30px 0;">
          No other files uploaded yet.
        </div>
      <% } %>
    </aside>

  </main>

  <!-- DELETE CONFIRMATION MODAL -->
  <div class="modal-backdrop" id="deleteModal">
    <div class="modal-box">
      <h3 class="modal-title">Delete File permanently?</h3>
      <p class="modal-desc">
        Are you sure you want to delete <strong><%= file.name %></strong>?<br>
        This will permanently remove the file from your Oracle Server disk.
      </p>
      <div class="modal-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeDeleteModal()">Cancel</button>
        <button type="button" class="btn-modal-delete" onclick="executeDelete()">Delete</button>
      </div>
    </div>
  </div>

  <!-- TOAST SNACKBAR -->
  <div class="toast-msg" id="toastMsg"></div>

  <script>
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeIcon(isDark);
    }

    function updateThemeIcon(isDark) {
      const icon = document.getElementById('themeIcon');
      if (icon) icon.textContent = isDark ? '☀️' : '🌙';
    }

    function showToast(text) {
      const t = document.getElementById('toastMsg');
      if (!t) return;
      t.textContent = text;
      t.style.display = 'block';
      setTimeout(() => {
        t.style.display = 'none';
      }, 3000);
    }

    function copyShareUrl() {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        showToast('Link copied to clipboard!');
      }).catch(() => {
        showToast('Link: ' + url);
      });
    }

    function toggleSubscribe() {
      const btn = document.getElementById('subBtn');
      if (btn.classList.contains('subscribed')) {
        btn.classList.remove('subscribed');
        btn.textContent = 'Subscribe';
        showToast('Unsubscribed from Oracle Cloud Server');
      } else {
        btn.classList.add('subscribed');
        btn.textContent = 'Subscribed ✓';
        showToast('Subscribed to Oracle Cloud Server!');
      }
    }

    let isLiked = false;
    function toggleLike() {
      const btn = document.getElementById('likeBtn');
      const countEl = document.getElementById('likeCount');
      if (!isLiked) {
        isLiked = true;
        btn.style.color = 'var(--yt-brand-red)';
        countEl.textContent = '15K';
        showToast('Added to Liked Videos');
      } else {
        isLiked = false;
        btn.style.color = '';
        countEl.textContent = '14K';
      }
    }

    function handleCommentSubmit(e, input) {
      if (e.key === 'Enter' && input.value.trim()) {
        const list = document.getElementById('commentsList');
        const item = document.createElement('div');
        item.className = 'comment-item';
        item.innerHTML = `
          <div class="comment-avatar" style="background:#dc2626;">N</div>
          <div class="comment-content">
            <div class="comment-user-row">
              <span class="comment-user">@numan</span>
              <span class="comment-time">Just now</span>
            </div>
            <div class="comment-text">${escapeHtml(input.value.trim())}</div>
            <div class="comment-actions">
              <span>👍 1</span> &bull; <span>Reply</span>
            </div>
          </div>
        `;
        list.prepend(item);
        input.value = '';
        showToast('Comment posted!');
      }
    }

    function escapeHtml(text) {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
      return text.replace(/[&<>"']/g, m => map[m]);
    }

    function openDeleteModal() {
      document.getElementById('deleteModal').style.display = 'flex';
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').style.display = 'none';
    }

    function executeDelete() {
      const category = '<%= file.category %>';
      const filename = '<%= encodeURIComponent(file.name) %>';
      fetch(`/delete/${category}/${filename}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        closeDeleteModal();
        if (data.success) {
          showToast('File deleted successfully!');
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 800);
        } else {
          showToast('Error: ' + data.message);
        }
      })
      .catch(() => {
        closeDeleteModal();
        showToast('Failed to delete file');
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const isDark = document.documentElement.classList.contains('dark');
      updateThemeIcon(isDark);
    });
  </script>
</body>
</html>
